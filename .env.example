# Copy this file to .env and configure a Groq API key for LLM reasoning.
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0
GROQ_TIMEOUT_SECONDS=20
GROQ_RETRY_MAX_ATTEMPTS=2
GROQ_RETRY_WAIT_BUDGET_SECONDS=25
GROQ_RETRY_BASE_DELAY_SECONDS=0.5
GROQ_MAX_COMPLETION_TOKENS=1000
AIOPS_TRACE_DIR=traces
# Optional admin-only bearer credential. Use at least 32 random characters.
# Leave empty to keep public approval/rejection actions disabled.
AIOPS_APPROVAL_TOKEN=
